; InitraOS - Global Descriptor Table

gdt_start:

; ---------------------------------------------------------------
; Null descriptor
; ---------------------------------------------------------------

gdt_null:
    dq 0x0000000000000000


; ---------------------------------------------------------------
; Kernel code segment
; Selector: 0x08
; DPL: 0
; ---------------------------------------------------------------

gdt_code:
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db 10011010b
    db 11001111b
    db 0x00


; ---------------------------------------------------------------
; Kernel data segment
; Selector: 0x10
; DPL: 0
; ---------------------------------------------------------------

gdt_data:
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db 10010010b
    db 11001111b
    db 0x00


; ---------------------------------------------------------------
; User code segment
; Selector: 0x18
; DPL: 3
; ---------------------------------------------------------------

gdt_user_code:
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db 11111010b
    db 11001111b
    db 0x00


; ---------------------------------------------------------------
; User data segment
; Selector: 0x20
; DPL: 3
; ---------------------------------------------------------------

gdt_user_data:
    dw 0xFFFF
    dw 0x0000
    db 0x00
    db 11110010b
    db 11001111b
    db 0x00


gdt_end:


; ---------------------------------------------------------------
; GDT descriptor
; ---------------------------------------------------------------

gdt_descriptor:
    dw gdt_end - gdt_start - 1
    dd gdt_start